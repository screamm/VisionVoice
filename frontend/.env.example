# VisionVoice Environment Variables
# Copy this file to .env.local and fill in your values

# Google AI API key for Gemini Vision
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ElevenLabs Agent ID (for voice conversation)
# Get from: https://elevenlabs.io/app/conversational-ai
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here

# ElevenLabs API Key (for Text-to-Speech)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID
# Choose from: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=your_voice_id_here
